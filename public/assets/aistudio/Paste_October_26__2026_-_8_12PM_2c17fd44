		toggleTts() {
			if (this.ttsState === "playing") {
				this.pauseTts();
			} else if (this.ttsState === "paused") {
				this.resumeTts();
			} else {
				this.startTts();
			}
		}
		startTts() {
			if (!window.speechSynthesis || !this.text || this.status !== "done") return;
			window.speechSynthesis.cancel();
			const clean = cleanTextForSpeech(this.text);
			if (!clean) return;
			const utt = new SpeechSynthesisUtterance(clean);
			utt.rate = this.ttsRate;
			utt.onend = () => {
				this.ttsState = "idle";
				this.ttsUtterance = null;
				this.updateTtsUI();
			};
			utt.onerror = (e) => {
				if (e && e.error !== "canceled" && e.error !== "interrupted") {
					console.warn("TTS error:", e);
				}
				this.ttsState = "idle";
				this.ttsUtterance = null;
				this.updateTtsUI();
			};
			this.ttsUtterance = utt;
			this.ttsState = "playing";
			window.speechSynthesis.speak(utt);
			this.updateTtsUI();
		}
		pauseTts() {
			if (window.speechSynthesis && this.ttsState === "playing") {
				window.speechSynthesis.pause();
				this.ttsState = "paused";
				this.updateTtsUI();
			}
		}
		resumeTts() {
			if (window.speechSynthesis && this.ttsState === "paused") {
				window.speechSynthesis.resume();
				this.ttsState = "playing";
				this.updateTtsUI();
			}
		}
		stopTts() {
			if (window.speechSynthesis) {
				window.speechSynthesis.cancel();
			}
			this.ttsState = "idle";
			this.ttsUtterance = null;
			this.updateTtsUI();
		}
		cycleTtsRate() {
			const rates = [
				1,
				1.25,
				1.5,
				2
			];
			const nextIdx = (rates.indexOf(this.ttsRate) + 1) % rates.length;
			this.ttsRate = rates[nextIdx];
			if (this.ttsState === "playing") {
				this.stopTts();
				this.startTts();
			} else {
				this.updateTtsUI();
			}
		}
