					text = seg.snippet.runs.map((r) => r.text).join("");
				} else if (seg.snippet?.simpleText) {
					text = seg.snippet.simpleText;
				}
				if (text) {
					segments.push({
						startMs,
						text: text.trim()
					});
				}
			}
			for (const k of Object.keys(node)) {
				walk(node[k]);
			}
