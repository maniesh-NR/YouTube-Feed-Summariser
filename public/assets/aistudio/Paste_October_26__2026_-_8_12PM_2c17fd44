	// --- OPEN FOR VIDEO HELPER (§4) ---
	function openForVideo({ videoId, title }) {
		if (!videoId) return;
		// 1. Existing local window
		if (activeWindows.has(videoId)) {
			activeWindows.get(videoId).maximize();
			return;
		}
		// 2. Existing remote registry entry
		const meta = GM_getValue("win:" + videoId, null);
		const win = new SummaryWindow(videoId, title, meta || {});
		// Check cache
		const cached = readCache(videoId, win.mode, win.source);
		if (cached) {
			win.loadFromCache(cached);
			win.commit(true);
			win.maximize();
			return;
		}
		// Check auto-start
		const keys = getStoredKeys();
		const isAsk = win.modelId.includes("Ask");
		if (getAutoStart() && (keys.length > 0 || isAsk)) {
			win.commit(true);
			win.startJob();
			return;
		}
		// Otherwise maximize idle
		win.commit(true);
		win.maximize();
		if (keys.length === 0 && !isAsk) {
			openKeyManagerDialog(() => win.renderAll());
		}
	}
	// --- 3-DOT MENU INTEGRATION (§5) ---
	let menuPollTimer = null;
	function initMenuIntegration() {
		document.addEventListener("click", (e) => {
			const path = e.composedPath();
			if (path.some((el) => el.id === "yt-ai-summary-host" || el?.dataset?.ytaisItem)) {
				return;
			}
			const card = path.find((el) => {
				if (!el || !el.tagName) return false;
				const tag = el.tagName.toLowerCase();
				return tag.startsWith("yt-lockup-view-model") || tag.startsWith("ytm-shorts-lockup-view-model") || tag === "ytd-rich-item-renderer" || tag === "ytd-video-renderer" || tag === "ytd-compact-video-renderer" || tag === "ytd-grid-video-renderer" || tag === "ytd-playlist-video-renderer" || tag === "ytd-reel-item-renderer";
			});
			if (!card) return;
			// Check if menu button was clicked
			const isMenuClick = path.some((el) => {
				if (!el || !el.getAttribute) return false;
				if (el.tagName?.toLowerCase() === "ytd-menu-renderer" || el.classList?.contains("yt-lockup-metadata-view-model__menu-button")) {
					return true;
				}
				const aria = el.getAttribute("aria-label") || "";
				if (/more actions|action menu/i.test(aria)) return true;
				if ((el.tagName?.toLowerCase() === "button" || el.tagName?.toLowerCase() === "yt-icon-button") && !el.closest("a[href], ytd-thumbnail, yt-thumbnail-view-model, #hover-overlays, #overlays")) {
					return true;
				}
				return false;
			});
			if (!isMenuClick) return;
			// Extract video ID and Title
			let videoId = "";
			const link = card.querySelector("a[href*=\"/watch?v=\"], a[href*=\"/shorts/\"]");
			if (link) {
				const href = link.getAttribute("href") || "";
				const matchV = /[?&]v=([^&]+)/.exec(href);
				if (matchV) videoId = matchV[1];
				else {
					const matchS = /\/shorts\/([a-zA-Z0-9_-]{11})/.exec(href);
					if (matchS) videoId = matchS[1];
				}
			}
			if (!videoId) return;
			let title = "";
			const titleEl = card.querySelector("#video-title, .yt-lockup-metadata-view-model__title, h3");
			if (titleEl) {
				title = (titleEl.getAttribute("title") || titleEl.textContent || "").trim();
			}
			// Poll for menu flyout
			if (menuPollTimer) clearInterval(menuPollTimer);
			let ticks = 0;
			menuPollTimer = setInterval(() => {
				ticks++;
				if (ticks > 45) {
					clearInterval(menuPollTimer);
					return;
				}
				const items = Array.from(document.querySelectorAll("ytd-menu-service-item-renderer, ytd-menu-navigation-item-renderer, yt-list-item-view-model, tp-yt-paper-item, [role=\"menuitem\"]")).filter((el) => {
					return el.offsetWidth > 0 && el.offsetHeight > 0 && !el.dataset.ytaisItem;
				});
				if (!items.length) return;
				let targetItem = null;
				let insertMode = "after";
				for (const it of items) {
					const label = (it.getAttribute("aria-label") || it.textContent || "").slice(0, 60).trim();
					if (CONFIG.savePattern.test(label)) {
						targetItem = it;
						insertMode = "after";
						break;
					}
				}
				if (!targetItem) {
					for (const it of items) {
						const label = (it.getAttribute("aria-label") || it.textContent || "").slice(0, 60).trim();
						if (CONFIG.downloadPattern.test(label)) {
							targetItem = it;
							insertMode = "before";
							break;
						}
					}
				}
				if (!targetItem) {
					for (const it of items) {
						const label = (it.getAttribute("aria-label") || it.textContent || "").slice(0, 60).trim();
						if (CONFIG.watchLaterPattern.test(label)) {
							targetItem = it;
							insertMode = "after";
							break;
						}
					}
				}
				if (targetItem) {
					clearInterval(menuPollTimer);
					injectMenuItem(targetItem, insertMode, {
						videoId,
						title
					});
				}
			}, 60);
		}, true);
	}
	function injectMenuItem(targetSibling, mode, ctx) {
		const parent = targetSibling.parentNode;
		if (!parent) return;
		// Remove existing injected items in this menu
		const existing = parent.querySelectorAll("[data-ytais-item]");
		for (const ex of existing) ex.remove();
		const item = h("div", {
			role: "menuitem",
			className: "ytd-menu-service-item-renderer yt-ai-menu-item",
			"data-ytais-item": "true",
			style: {
				display: "flex",
				alignItems: "center",
				gap: "16px",
				fontSize: CONFIG.menuFontSize,
				fontWeight: "500",
				minHeight: `${CONFIG.menuMinHeight}px`,
				padding: "0 16px",
				cursor: "pointer",
				color: "var(--yt-spec-text-primary, #f1f1f1)",
				userSelect: "none"
			},
			onmouseenter: () => {
				item.style.backgroundColor = "var(--yt-spec-10-percent-layer, rgba(255,255,255,0.1))";
			},
			onmouseleave: () => {
				item.style.backgroundColor = "transparent";
			},
			onclick: (e) => {
				e.preventDefault();
				e.stopPropagation();
				// Close flyout
				const active = document.activeElement;
				if (active) {
					active.dispatchEvent(new KeyboardEvent("keydown", {
						key: "Escape",
						code: "Escape",
						bubbles: true
					}));
				}
				document.dispatchEvent(new KeyboardEvent("keyup", {
					key: "Escape",
					code: "Escape",
					bubbles: true
				}));
				setTimeout(() => {
					document.body.click();
					openForVideo(ctx);
				}, 150);
			}
		}, iconSparkle(26), h("span", {}, CONFIG.menuLabel));
		if (mode === "before") {
			parent.insertBefore(item, targetSibling);
		} else {
			parent.insertBefore(item, targetSibling.nextSibling);
		}
	}
